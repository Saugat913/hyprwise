# ==============================================================================
# Hyprwise Environment Configuration
# Load at build time via terminal:
#   flutter run --dart-define-from-file=.env
#   flutter build appbundle --dart-define-from-file=.env
# ==============================================================================

# Backend Server URL (Required)
SERVER_URL=https://hyprwise.kandelsaugat913.workers.dev

# Subscriptions (RevenueCat API Keys)
REVENUECAT_GOOGLE_KEY=goog_your_revenuecat_google_key
REVENUECAT_APPLE_KEY=appl_your_revenuecat_apple_key

# Firebase Client API Keys
FIREBASE_ANDROID_API_KEY=your_android_api_key_here
FIREBASE_IOS_API_KEY=your_ios_api_key_here
FIREBASE_WEB_API_KEY=your_web_api_key_here

# Apple App Store Connect Credentials (for iOS automated release)
APP_STORE_CONNECT_KEY_IDENTIFIER=VAF7GQY5U2
APP_STORE_CONNECT_ISSUER_ID=1b2be7f4-cf12-440b-8e65-f0e39d6f6074

# Deployment Environment (production / development / staging)
ENVIRONMENT=production
