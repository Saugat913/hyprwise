<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_actions_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <!-- Income Action Tile -->
    <LinearLayout
        android:id="@+id/widget_btn_income"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:background="@drawable/widget_action_tile_bg"
        android:clickable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="6dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/widget_icon_income_bg"
            android:contentDescription="Income"
            android:padding="7dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_widget_income" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Income"
            android:textColor="@color/widget_ink"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Expense Action Tile -->
    <LinearLayout
        android:id="@+id/widget_btn_expense"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:background="@drawable/widget_action_tile_bg"
        android:clickable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="6dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/widget_icon_expense_bg"
            android:contentDescription="Expense"
            android:padding="7dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_widget_expense" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Expense"
            android:textColor="@color/widget_ink"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Lend Action Tile -->
    <LinearLayout
        android:id="@+id/widget_btn_lend"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:background="@drawable/widget_action_tile_bg"
        android:clickable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="6dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/widget_icon_lend_bg"
            android:contentDescription="Lend"
            android:padding="7dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_widget_lend" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Lend"
            android:textColor="@color/widget_ink"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Borrow Action Tile -->
    <LinearLayout
        android:id="@+id/widget_btn_borrow"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/widget_action_tile_bg"
        android:clickable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="6dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/widget_icon_borrow_bg"
            android:contentDescription="Borrow"
            android:padding="7dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_widget_borrow" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Borrow"
            android:textColor="@color/widget_ink"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
