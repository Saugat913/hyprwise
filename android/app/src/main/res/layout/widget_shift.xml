<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_shift_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Header Row: Live Status Dot + Job Name -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_shift_status_icon"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/ic_widget_dot_inactive" />

        <TextView
            android:id="@+id/widget_shift_job"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="NO ACTIVE SHIFT"
            android:textColor="#0F172A"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Subtitle: Live Timer & Earnings or Clock In Prompt -->
    <TextView
        android:id="@+id/widget_shift_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Tap to start a shift"
        android:textColor="#64748B"
        android:textSize="12.5sp" />

    <!-- Weight spacer (RemoteViews compatible View; NEVER use Space) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Active Shift Action Buttons: Break & End -->
    <LinearLayout
        android:id="@+id/widget_shift_active_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button
            android:id="@+id/widget_shift_btn_break"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:background="@drawable/widget_button_bg"
            android:text="break"
            android:textAllCaps="false"
            android:textColor="#0F172A"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/widget_shift_btn_end"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:background="@drawable/widget_button_bg"
            android:text="end"
            android:textAllCaps="false"
            android:textColor="#DC2626"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Inactive Shift Action Button: Start Shift -->
    <Button
        android:id="@+id/widget_shift_btn_start"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="@drawable/widget_button_primary_bg"
        android:text="start shift"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="12.5sp"
        android:textStyle="bold"
        android:visibility="visible" />

</LinearLayout>
