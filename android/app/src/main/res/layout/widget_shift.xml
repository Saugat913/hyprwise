<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_shift_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Job Title Header (e.g. CAFE) -->
    <TextView
        android:id="@+id/widget_shift_job"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="CAFE"
        android:textColor="#0F172A"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Subtitle: Time and pay rates -->
    <TextView
        android:id="@+id/widget_shift_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="time and pay rates"
        android:textColor="#64748B"
        android:textSize="13sp" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Action buttons row: break | end -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/widget_shift_btn_break"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_button_bg"
            android:text="break"
            android:textAllCaps="false"
            android:textColor="#0F172A"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/widget_shift_btn_end"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_button_bg"
            android:text="end"
            android:textAllCaps="false"
            android:textColor="#DC2626"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
